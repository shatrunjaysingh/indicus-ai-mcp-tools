# Copy to .env and fill in. .env is gitignored and never committed.
# Twilio console: https://console.twilio.com  ->  Account Info panel

OUTREACH_PROVIDER=twilio-inline
OUTREACH_TIMEZONE=America/New_York

# Your own mobile. Every call goes here regardless of which consumers a rule
# selected, until OUTREACH_ALLOW_LIVE is set. Leave it unset.
OUTREACH_TEST_NUMBER=+1

# From the Twilio console dashboard.
TWILIO_ACCOUNT_SID=AC
TWILIO_AUTH_TOKEN=
# The number you bought, in +1XXXXXXXXXX form.
TWILIO_FROM_NUMBER=+1
